{
  "expo": {
    "name": "SubFinance",
    "slug": "subfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f4fb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.subfinance.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used for secure authentication",
        "NSCameraUsageDescription": "Used to scan receipts",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f4fb"
      },
      "package": "com.subfinance.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SubFinance",
      "shortName": "SubFinance",
      "description": "Smart subscription intelligence. Track, analyze, and optimize all your subscriptions.",
      "themeColor": "#6366f1",
      "backgroundColor": "#f5f4fb"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "96dec651-eac4-42a6-ac6a-d08953308d67"
      }
    },
    "owner": "pinak_shome"
  }
}