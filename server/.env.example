# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# Google OAuth (Gmail import)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gmail/callback

# Anthropic (AI alternatives)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Error monitoring (optional — leave unset to disable Sentry)
SENTRY_DSN=

# Extra CORS origins, comma-separated (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Server
PORT=3001
NODE_ENV=development
